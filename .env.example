# Provedor dos modelos: openai ou google
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# --- Banco de dados / pgVector ---
# O driver psycopg (v3) é obrigatório no início da URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=document_chunks

# --- Documento ---
PDF_PATH=document.pdf
